rules_version = '2';
// Luật bảo mật Firestore cho bản thử nghiệm.
// Yêu cầu: bật Authentication → Sign-in method → Anonymous.
// Chỉ cho phép đọc/ghi các collection bắt đầu bằng "thanglong_" (đổi nếu bạn đổi collectionPrefix).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{coll}/{docId} {
      allow read, write: if request.auth != null && coll.matches('thanglong_.*');
    }
  }
}
